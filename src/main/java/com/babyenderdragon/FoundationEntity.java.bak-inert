package com.babyenderdragon;

import net.minecraft.network.syncher.EntityDataAccessor;
import net.minecraft.network.syncher.EntityDataSerializers;
import net.minecraft.network.syncher.SynchedEntityData;
import net.minecraft.server.level.ServerLevel;
import net.minecraft.world.damagesource.DamageSource;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.level.Level;
import net.minecraft.world.level.storage.ValueInput;
import net.minecraft.world.level.storage.ValueOutput;

/**
 * Baby Ender Dragon — Phase 1 foundation entity.
 *
 * <p>This is deliberately the smallest entity that satisfies Gate 1: it must be registered, exist
 * server-side, persist across a clean save/stop/restart of the same world, and keep a stable UUID and
 * registered type.
 *
 * <p><b>Explicitly not implemented, and gated until Gate 2 is green:</b> flight, riding/passengers,
 * a second passenger, egg hatching, taming, ownership, chorus-fruit healing, combat, purple fire
 * breath, purple fireballs, and any renderer or animation polish. Nothing here influences movement,
 * damage, or player interaction.
 *
 * <p>It extends {@link Entity} rather than {@code LivingEntity} or {@code Mob} on purpose: no AI goals,
 * no attributes, no hurt handling, and nothing that could silently add gameplay behaviour later.
 */
public final class FoundationEntity extends Entity {
	private static final EntityDataAccessor<Boolean> DATA_MARKER =
			SynchedEntityData.defineId(FoundationEntity.class, EntityDataSerializers.BOOLEAN);

	public FoundationEntity(EntityType<? extends FoundationEntity> type, Level level) {
		super(type, level);
	}

	@Override
	protected void defineSynchedData(SynchedEntityData.Builder builder) {
		builder.define(DATA_MARKER, false);
	}

	@Override
	public void tick() {
		super.tick();
		// No movement, no AI, no abilities. This entity is inert by design in Phase 1.
	}

	/**
	 * Persistence in this Minecraft version uses {@code ValueOutput}/{@code ValueInput}, not NBT
	 * compounds. This entity intentionally stores no custom state, so the default UUID round-trip
	 * through the {@code Entity} base class is exactly what Gate 1 verifies. These two methods are
	 * abstract on {@code Entity} and cannot delegate to a super implementation, so they are
	 * intentionally empty bodies.
	 */
	@Override
	protected void addAdditionalSaveData(ValueOutput output) {
		// No custom state in Phase 1.
	}

	@Override
	protected void readAdditionalSaveData(ValueInput input) {
		// No custom state in Phase 1.
	}

	/**
	 * In this version {@code Entity.hurtServer(ServerLevel, DamageSource, float)} is the abstract
	 * damage entry point ({@code hurt(...)} is final). The foundation entity has no combat behaviour,
	 * so it declines all damage.
	 */
	@Override
	public boolean hurtServer(ServerLevel level, DamageSource source, float amount) {
		return false;
	}
}